    status_bar->h = 20;

    /* 桌面图标网格：4 列 x 3 行，自动流放置 12 个图标 */
    ipgui_widget_t * desk_grid = ipgui_widget_create(NULL);
    desk_grid->name = "桌面网格";
    desk_grid->x = 266;
    desk_grid->y = 31;
    desk_grid->w = 268;
    desk_grid->h = 414;

    static const ipgui_grid_track_t desk_cols[] = {
        {IPGUI_GRID_TRACK_FR, 1}, {IPGUI_GRID_TRACK_FR, 1},
        {IPGUI_GRID_TRACK_FR, 1}, {IPGUI_GRID_TRACK_FR, 1},
    };
    static const ipgui_grid_track_t desk_rows[] = {
        {IPGUI_GRID_TRACK_FR, 1}, {IPGUI_GRID_TRACK_FR, 1},
        {IPGUI_GRID_TRACK_FR, 1},
    };
    ipgui_grid_cfg_t desk_cfg = {
        .cols = desk_cols,
        .col_count = 4,
        .rows = desk_rows,
        .row_count = 3,
        .items = (const ipgui_grid_item_t *)0,
        .item_count = 0,
        .col_gap = 4,
        .row_gap = 6,
        .pad_left = 8,
        .pad_top = 36,
        .pad_right = 8,
        .pad_bottom = 22,
    };

    for (u8_t i = 0; i < APP_ICON_COUNT; i++) {
        ipgui_img_dsc_t icon_dsc;
        app_icons[i].img = (ipgui_image_data_t *)0;
        app_icons[i].label = app_icon_labels[i];

        if (0 == test_bmp(app_icon_paths[i], &icon_dsc)) {
            app_imgs[i].pixmap  = icon_dsc.pixmap;
            app_imgs[i].px_size = (u8_t)(icon_dsc.stride / icon_dsc.w);
            app_imgs[i].fmt     = IPGUI_IMG_FMT_BGR888;  /* 24bit bmp 内存顺序 B,G,R */
            app_imgs[i].stride  = icon_dsc.stride;
            app_imgs[i].w       = icon_dsc.w;
            app_imgs[i].h       = icon_dsc.h;
            app_icons[i].img    = &app_imgs[i];
        } else {
            printf("load app icon failed: %s\n", (const char *)app_icon_paths[i]);
        }

        ipgui_widget_t * icon = ipgui_widget_create(desk_grid);
        icon->name = (const char *)app_icon_labels[i];
        icon->render = app_icon_render;
        icon->priv_data = (void *)&app_icons[i];
        icon->w = 60;
        icon->h = 100;
    }
    ipgui_grid_apply(desk_grid, &desk_cfg);

    ipgui_widget_t * desk_dots = ipgui_widget_create(NULL);
    desk_dots->name = "页码点";
    desk_dots->render = desk_dots_render;
    desk_dots->x = 266;
    desk_dots->y = 437;
    desk_dots->w = 268;
    desk_dots->h = 8;

    ipgui_widget_t * btn_back2 = ipgui_widget_create(NULL);
    btn_back2->name = "BACK";
    btn_back2->render = color_render;
    btn_back2->event_handler = page2_back_handler;
    btn_back2->x = 20;
    btn_back2->y = 425;
    btn_back2->w = 120;
    btn_back2->h = 40;
    btn_back2->priv_data = (void *)&col_gray;

    /* 第 2 页的 NEXT：进阴影用例页 */
    ipgui_widget_t * btn_next3 = ipgui_widget_create(NULL);
    btn_next3->name = "NEXT";
    btn_next3->render = color_render;
    btn_next3->event_handler = page_next3_handler;
    btn_next3->x = 660;
    btn_next3->y = 425;
    btn_next3->w = 120;
    btn_next3->h = 40;
    btn_next3->priv_data = (void *)&col_purple;

    /* ========== 第 3 页：阴影用例 ========== */
    ipgui_screen_page_switch(&main_screen, 3);

    ipgui_widget_t * shadow_bg = ipgui_widget_create(NULL);
    shadow_bg->name = NULL;
    shadow_bg->render = shadow_page_bg_render;
    shadow_bg->x = 0;
    shadow_bg->y = 0;
    shadow_bg->w = 799;
    shadow_bg->h = 479;

    /* 阴影会画到控件本体之外，这里用一个全屏控件承载，避免被裁剪 */
    ipgui_widget_t * shadow_cases_w = ipgui_widget_create(NULL);
    shadow_cases_w->name = NULL;
    shadow_cases_w->render = shadow_cases_render;
    shadow_cases_w->x = 0;
    shadow_cases_w->y = 0;
    shadow_cases_w->w = 799;
    shadow_cases_w->h = 479;

    ipgui_widget_t * btn_back3 = ipgui_widget_create(NULL);
    btn_back3->name = "BACK";
    btn_back3->render = color_render;
    btn_back3->event_handler = page3_back_handler;
    btn_back3->x = 20;
    btn_back3->y = 425;
    btn_back3->w = 120;
    btn_back3->h = 40;
    btn_back3->priv_data = (void *)&col_gray;

    ipgui_widget_t * btn_next4 = ipgui_widget_create(NULL);
    btn_next4->name = "HMI";
    btn_next4->render = color_render;
    btn_next4->event_handler = page_next4_handler;
    btn_next4->x = 660;
    btn_next4->y = 425;
    btn_next4->w = 120;
    btn_next4->h = 40;
    btn_next4->priv_data = (void *)&col_purple;

    /* ========== 第 4 页：E-MOTION 电摩 HMI（RIDE）========== */
    ipgui_page_emoto_init(&main_screen, 4);

    /* ========== 第 5 页：E-MOTION 电摩 HMI（NAV）========== */
    ipgui_page_emoto_nav_init(&main_screen, 5);

    /* 启动页：直接进入 E-MOTION RIDE
     * 如果想回到原来的演示首页，把下面这行改成 page 0 即可 */
    ipgui_screen_page_switch(&main_screen, 4);

    /* ========== 曲线控件 ========== */
    // ipgui_widget_t * widget_curve = ipgui_widget_create(NULL);
    // widget_curve->name   = "实时曲线";
    // widget_curve->render = curve_render;
    // widget_curve->x      = 0;
    // widget_curve->y      = 0;
    // widget_curve->w      = 800;
    // widget_curve->h      = 480;


    ipgui_input_src_evt_t raw_evt;
    u32_t last_tick_ms = SDL_GetTicks();

    while(1)
    {
        /* 读取所有待处理指针事件，不再把“空事件”塞进队列 */
        while (pointer_src.input_src_event_read_cb(&pointer_src, &raw_evt)
               == IPGUI_ERR_READ_INPUT_SRC_EVT_OK) {
            ipgui_norm_queue_post(&dispatcher.evt_queue, &raw_evt, sizeof(raw_evt));
        }

        /* 悬停状态每帧复位，dispatch 会在当帧重新设置
         * 只推进当前页的控件，避免非活动页往 HMI 的帧里提交脏矩形 */
        if (main_screen.act_page == 0) {
            widget_livingroom_update(widget_labal_livingroom);
            widget_tablelamp_update(widget_tablelamp);
        }
        
        ipgui_dispatch_input_event(&dispatcher);
        /* 驱动所有动画，需在渲染之前调用 */
        ipgui_anim_update_all();

        /* E-MOTION 两页共用车辆状态：RIDE 页始终推进模拟，
         * 内部只在 RIDE 可见时提交脏矩形；NAV 页自行按可见性刷新 */
        ipgui_page_emoto_tick();
        ipgui_page_emoto_nav_tick();

        ipgui_screen_render(&main_screen);

        /* 每个控件自己的 per-frame update（仅第 0 页） */
        if (main_screen.act_page == 0) {
            widget_switch_label_update(widget_switch_label);
            widget_switch_update(widget_switch);
            widget_knob_update(widget_brightness_label);
            widget_wave_update(widget3);
            // widget_curve_update(widget_curve);
        }

        /* 心跳：按真实毫秒推进，保证 HMI 动画速度与墙钟一致 */
        {
            u32_t now_ms = SDL_GetTicks();
            u32_t delta = now_ms - last_tick_ms;
            last_tick_ms = now_ms;
            if (delta > 50) delta = 50;
            while (delta --) ipgui_tick_inc();
        }
        Sleep(1);
    }


	return 0;
}
