<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}PriceWatch 竞品监控{% endblock %}</title>
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
{% if user %}
<nav class="nav">
  <a class="brand" href="/">Price<span>Watch</span></a>
  <div class="links">
    <a href="/">概览</a>
    <a href="/events">变化</a>
    <a href="/stores/new">添加店铺</a>
    <a href="/pricing">套餐</a>
  </div>
  <div class="who">
    <span class="mail">{{ user.email }}</span>
    <a href="/logout">退出</a>
  </div>
</nav>
{% endif %}
<main class="wrap">
{% block body %}{% endblock %}
</main>
<footer class="foot">PriceWatch · 仅采集店铺公开商品接口，不抓取登录后数据</footer>
</body>
</html>
