{% extends "base.html.j2" %}
{% block title %}{{ "登录" if mode == "login" else "注册" }} · PriceWatch{% endblock %}
{% block body %}
<div class="auth">
  <h1>{{ "登录" if mode == "login" else "创建账号" }}</h1>
  <p class="sub">
    {% if mode == "login" %}登录后查看竞品价格与库存变化{% else %}免费账号可以监控 1 个店铺{% endif %}
  </p>

  {% if error %}<div class="alert">{{ error }}</div>{% endif %}

  <form method="post" action="{{ '/login' if mode == 'login' else '/register' }}">
    <label>邮箱
      <input type="email" name="email" value="{{ email }}" required autofocus>
    </label>
    <label>密码
      <input type="password" name="password" required
             {% if mode == "register" %}minlength="8"{% endif %}>
    </label>
    <button type="submit">{{ "登录" if mode == "login" else "注册并开始" }}</button>
  </form>

  <p class="switch">
    {% if mode == "login" %}
      还没有账号？<a href="/register">注册</a>
    {% else %}
      已有账号？<a href="/login">登录</a>
    {% endif %}
  </p>
</div>
{% endblock %}
