{% extends "base.html.j2" %}
{% block title %}{{ store.label }} · PriceWatch{% endblock %}
{% block body %}
<div class="head">
  <div>
    <h1>{{ store.label }}</h1>
    <p class="sub">
      {{ store.url }} · <span class="tag">{{ store.platform }}</span>
      · 每 {{ store.interval_min }} 分钟采集一次
    </p>
  </div>
  <div class="actions">
    <form method="post" action="/stores/{{ store.id }}/collect" class="inline">
      <button type="submit">立即采集</button>
    </form>
    <form method="post" action="/stores/{{ store.id }}/delete" class="inline"
          onsubmit="return confirm('确定删除这个店铺及其全部历史记录？')">
      <button class="danger" type="submit">删除</button>
    </form>
  </div>
</div>

{% if store.last_error %}
<div class="alert">上次采集失败：{{ store.last_error }}</div>
{% endif %}

<div class="stats">
  <div class="stat"><div class="v">{{ total }}</div><div class="k">在售商品</div></div>
  <div class="stat"><div class="v">{{ events|length }}</div><div class="k">最近变化</div></div>
  <div class="stat wide"><div class="v small">{{ ft(store.last_checked_at) if store.last_checked_at else "尚未采集" }}</div><div class="k">上次采集</div></div>
</div>

<h2>商品（{{ total }}）</h2>
{% if products %}
<table class="tbl">
  <thead>
    <tr><th>商品</th><th>当前价</th><th>库存</th><th>变化次数</th></tr>
  </thead>
  <tbody>
  {% for p in products %}
    <tr>
      <td>
        {% if p.url %}
          <a href="{{ p.url }}" target="_blank" rel="noopener nofollow">{{ p.name }}</a>
        {% else %}{{ p.name }}{% endif %}
      </td>
      <td class="mono">{{ fmt(p.last_price, p.currency, p.minor_unit) }}</td>
      <td>
        {% if p.last_in_stock is none %}<span class="dim">-</span>
        {% elif p.last_in_stock %}<span class="tag good">有货</span>
        {% else %}<span class="tag bad">缺货</span>{% endif %}
      </td>
      <td class="mono">{{ p.event_count }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% if pages > 1 %}
<div class="pager">
  {% if page_no > 1 %}
    <a class="btn ghost" href="/stores/{{ store.id }}?page={{ page_no - 1 }}">上一页</a>
  {% else %}<span></span>{% endif %}
  <span class="dim">第 {{ page_no }} / {{ pages }} 页</span>
  {% if page_no < pages %}
    <a class="btn ghost" href="/stores/{{ store.id }}?page={{ page_no + 1 }}">下一页</a>
  {% else %}<span></span>{% endif %}
</div>
{% endif %}
{% else %}
<div class="empty">这个店铺还没有采集到商品，点上方「立即采集」重试。</div>
{% endif %}

<h2>最近变化</h2>
{% if events %}
  {% include "_events.html.j2" %}
{% else %}
<div class="empty">暂无变化记录。</div>
{% endif %}
{% endblock %}
