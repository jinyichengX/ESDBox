{% extends "base.html.j2" %}
{% block title %}变化记录 · PriceWatch{% endblock %}
{% block body %}
<div class="head">
  <h1>变化记录</h1>
</div>

<form class="filters" method="get" action="/events">
  <select name="store_id">
    <option value="0">全部店铺</option>
    {% for s in stores %}
    <option value="{{ s.id }}" {% if s.id == cur_store %}selected{% endif %}>{{ s.label }}</option>
    {% endfor %}
  </select>
  <select name="type">
    <option value="">全部类型</option>
    {% for k, v in event_labels.items() %}
    <option value="{{ k }}" {% if k == cur_type %}selected{% endif %}>{{ v }}</option>
    {% endfor %}
  </select>
  <button type="submit">筛选</button>
  <a class="btn ghost" href="/events">重置</a>
</form>

{% if events %}
  {% include "_events.html.j2" %}
{% else %}
<div class="empty">没有符合条件的变化记录。</div>
{% endif %}
{% endblock %}
