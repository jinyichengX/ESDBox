<table class="tbl">
  <thead>
    <tr><th>时间</th><th>店铺</th><th>类型</th><th>商品</th><th>变化</th></tr>
  </thead>
  <tbody>
  {% for e in events %}
    <tr>
      <td class="dim mono">{{ ft(e.created_at) }}</td>
      <td class="dim">{{ e.store_label }}</td>
      <td><span class="tag {{ event_tones.get(e.type, '') }}">{{ event_labels.get(e.type, e.type) }}</span></td>
      <td>
        {% if e.product_url %}
          <a href="{{ e.product_url }}" target="_blank" rel="noopener nofollow">{{ e.product_name }}</a>
        {% else %}
          {{ e.product_name }}
        {% endif %}
      </td>
      <td class="mono">
        {% if e.old_value and e.new_value %}{{ e.old_value }} → {{ e.new_value }}
        {% elif e.new_value %}{{ e.new_value }}
        {% else %}-{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
